    "allFields": {
      "type": "string",
      "title": "All original fields (JSON)",
      "template": "{{links.apiDefaultDatasetUrl}}/items"
    },
    "license": {
      "type": "string",
      "title": "Attribution and license notice",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/LICENSE_NOTICE"
